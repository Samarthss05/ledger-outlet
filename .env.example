# Browser-safe Supabase project URL and publishable key
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# The same project settings for the server-side AI endpoint
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Server-only. Leave blank until your OpenRouter key is available.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
OPENROUTER_AGENT_MODEL=openai/gpt-5.4-mini
APP_URL=http://localhost:5173
PORT=3001
