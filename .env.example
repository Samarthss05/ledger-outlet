# Browser-safe Supabase project URL and publishable key
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# The same project settings for the server-side AI endpoint
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Server-only secret key for signed Meta webhooks; never prefix with VITE_.
SUPABASE_SECRET_KEY=

# Server-only. Leave blank until your OpenRouter key is available.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
OPENROUTER_AGENT_MODEL=openai/gpt-5.4
APP_URL=http://localhost:5173
PORT=3001

# Leave blank until the shared WhatsApp number is registered in Meta Cloud API.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_SHARED_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=
WHATSAPP_ORDER_TEMPLATE_NAME=
WHATSAPP_ORDER_TEMPLATE_LANGUAGE=en
WHATSAPP_OWNER_ALERT_TEMPLATE_NAME=
WHATSAPP_OWNER_ALERT_TEMPLATE_LANGUAGE=en
# Optional secret for an external scheduler to retry queued inbox events.
WHATSAPP_WORKER_SECRET=
